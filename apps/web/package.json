{
  "name": "@lie/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5176 --strictPort",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit && tsc -p ../../spikes/safari-audio/tsconfig.json",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "test": "vitest run && vitest run --config ../../spikes/safari-audio/vitest.config.ts",
    "predev": "node ../../scripts/character-presets.mjs",
    "prebuild": "node ../../scripts/character-presets.mjs",
    "pretypecheck": "node ../../scripts/character-presets.mjs",
    "pretest": "node ../../scripts/character-presets.mjs",
    "postbuild": "node ../../scripts/character-presets.mjs --check --output dist/appearances && node ../../spikes/safari-audio/build.mjs --publish"
  },
  "dependencies": {
    "@lie/game-core": "0.0.0",
    "@lie/ui": "0.0.0",
    "@lie/voice": "0.0.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  }
}
