{
  "name": "lie",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "npm run dev --workspace @lie/web",
    "dev:main": "node scripts/main-preview.mjs",
    "build": "npm run build --workspace @lie/web && npm run build --workspace @lie/gateway",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:main-preview": "node --test scripts/main-preview.test.mjs",
    "test": "npm run test:main-preview && npm run test:character-presets && npm run test --workspaces --if-present",
    "character-presets:generate": "node scripts/character-presets.mjs",
    "character-presets:check": "node scripts/character-presets.mjs --check",
    "test:character-presets": "node --test scripts/character-presets.test.mjs",
    "coverage": "node scripts/coverage.mjs",
    "coverage:snapshot": "node scripts/coverage-report.mjs --snapshot"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    },
    "@cloudflare/config": {
      "zod": "4.6.6"
    }
  }
}
