{
  "name": "lie",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "npm run dev --workspace @lie/web",
    "build": "npm run build --workspace @lie/web && npm run build --workspace @lie/gateway",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:appearances && npm run test --workspaces --if-present",
    "appearances:generate": "node scripts/appearances.mjs",
    "appearances:check": "node scripts/appearances.mjs --check",
    "test:appearances": "node --test scripts/appearances.test.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    },
    "@cloudflare/config": {
      "zod": "4.6.6"
    }
  }
}
